# Client-safe values only. Use a Supabase publishable/anon key, NEVER a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Cloudflare Turnstile public site key (set secret in Supabase Edge Function secrets)
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY

# Official Pixxivo Instagram account (confirmed by owner; optional override).
VITE_PIXXIVO_INSTAGRAM_URL=https://www.instagram.com/pixxivo/
